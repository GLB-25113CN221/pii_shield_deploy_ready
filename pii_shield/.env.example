BLOCK_HIGH_RISK_FIELDS=false
MAX_FILE_MB=20
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
AUDIT_DB=pii_shield_audit.sqlite3
# AI4Bharat IndicNER supports Assamese, Bengali, Gujarati, Hindi, Kannada,
# Malayalam, Marathi, Odia, Punjabi, Tamil, Telugu.
PII_NER_MODEL=ai4bharat/IndicNER
# Default false: only load already-cached weights. Set true only after accepting
# the gated Hugging Face model conditions and authenticating with HF_TOKEN.
PII_NER_ALLOW_DOWNLOAD=false
